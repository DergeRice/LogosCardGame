# Netlify frontend build environment: public URL, no secrets
# Keep blank locally to use Vite's WebSocket proxy.
VITE_WS_URL=
# Netlify: set VITE_WS_URL=wss://YOUR-WORKER.workers.dev/socket
# Local Node runtime (Cloudflare uses wrangler.jsonc vars)
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cloudflare wrangler vars: ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
# MATCH_SECONDS=0: unlimited match; reconnection grace is 180 seconds
MATCH_SECONDS=0
RECONNECT_SECONDS=180
# Apple Sign in: public web Services ID and registered return URL.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
# Set these only on the Node server / Cloudflare Worker, never in Vite variables.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# BGM file is read from public/audio/bgm.mp3 when provided.
