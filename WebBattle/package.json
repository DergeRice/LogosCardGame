{
  "name": "logos-web-battle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 0.0.0.0\"",
    "prebuild": "npm run cards:build",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "check:cloudflare": "tsc -p tsconfig.cloudflare.json",
    "dev:cloudflare": "wrangler dev --port 8787",
    "deploy:cloudflare": "npm run check:cloudflare && wrangler deploy",
    "test:cloudflare": "npm run check:cloudflare && wrangler deploy --dry-run --outdir .runtime/cloudflare-build && node scripts/test-cloudflare.mjs",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:parity": "tsx scripts/compare-grammar.ts",
    "profile-editor": "tsx scripts/profile-editor.ts",
    "cards:build": "tsx scripts/generate-card-faces.ts",
    "version:next": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "miniflare": "^5.20260925.0-alpha",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.141.0"
  }
}
